######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\cookbook\src\app\app.component.html #########
<div class="app-shell">
  <app-header></app-header>
  <main class="app-main" role="main">
    <router-outlet></router-outlet>
  </main>
  <footer class="app-footer" role="contentinfo">
    <div class="footer-inner">
      <p class="footer-line">
        <span class="footer-brand" x-test-footer-brand>CookBook</span>
        <span class="footer-sep">·</span>
        <span class="footer-note">Fixed demo recipes, kept in memory only</span>
      </p>
      
    </div>
  </footer>
  <app-toast></app-toast>
</div>
######### END FILE #########
######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\cookbook\src\app\toast\toast.component.html #########
@if (store.toast() !== '') {
<div class="toast-bar" role="status" aria-live="polite">
 <div class="toast-box">
  <span class="toast-icon" aria-hidden="true">i</span>
  <p class="toast-message" x-test-toast-message>{{ store.toast() }}</p>
  <button type="button" class="toast-close" aria-label="Dismiss message" (click)="store.toast.set('')">×</button>
 </div>
</div>
}
######### END FILE #########
