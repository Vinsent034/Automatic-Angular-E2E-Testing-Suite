######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\cookbook\src\app\step-item\step-item.component.html #########
<div class="step" [attr.data-step]="step().n">
  <div class="step-marker">
    <span class="step-number" [attr.x-test-step-number]="step().n">{{ step().n }}</span>
    <span class="step-dot" aria-hidden="true"></span>
  </div>
  
</div>
######### END FILE #########
######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\cookbook\src\app\app.component.html #########
<div class="app-shell">
 <app-header></app-header>
 <main class="app-main" role="main">
  <router-outlet>
   <div class="step-content">
    <p class="step-text" [attr.x-test-step-text]="step().n">{{ step().text }}</p>
    <p class="step-time"><span class="step-minutes">{{ step().minutes }}</span> min</p>
   </div>
  </router-outlet>
 </main>
 <footer class="app-footer" role="contentinfo">
  <div class="footer-inner">
   <p class="footer-line"><span class="footer-brand" x-test-footer-brand>CookBook</span> <span class="footer-sep">·</span> <span class="footer-note">Fixed demo recipes, kept in memory only</span></p>
   <p class="footer-line footer-meta"><span class="footer-label">Version</span> <span class="footer-version" x-test-footer-version>v1.0</span></p>
  </div>
 </footer>
 <app-toast></app-toast>
</div>
######### END FILE #########
