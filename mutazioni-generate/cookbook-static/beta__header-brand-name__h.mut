#mutation-id: h
#element: beta
#name: header-brand-name
#type: tag_mov_temp_mut
#status: COMPLETE
######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\cookbook\src\app\header\header.component.html #########
<header class="app-header">
  <div class="header-inner">
    <div class="brand-block">
      
      <span class="brand-tagline">Recipe demo</span>
    </div>
    <nav class="main-nav" aria-label="Main navigation">
      <ul class="nav-list">
        <li class="nav-item">
          <a class="nav-link" routerLink="/" routerLinkActive="active" [routerLinkActiveOptions]="{ exact: true }">Recipes</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" routerLink="/shopping" routerLinkActive="active" x-test-nav-shopping>Shopping</a>
          <span class="nav-badge" data-kind="shopping">{{ store.shoppingOpenCount() }}</span>
        </li>
        <li class="nav-item">
          <a class="nav-link" routerLink="/stats" routerLinkActive="active" x-test-nav-stats>Stats</a>
          <span class="nav-hint">numbers</span>
        </li>
      </ul>
    </nav>
  </div>
</header>
######### END FILE #########
######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\cookbook\src\app\step-item\step-item.component.html #########
<div class="step" [attr.data-step]="step().n">
 <div class="step-marker">
  <span class="step-number" [attr.x-test-step-number]="step().n">{{ step().n }}</span> <span class="step-dot" aria-hidden="true"></span>
 </div>
 <div class="step-content">
  <p class="step-text" [attr.x-test-step-text]="step().n">{{ step().text }}</p>
  <p class="step-time"><a class="brand-link" routerLink="/"> <span class="brand-mark" aria-hidden="true">◆</span> <span class="brand-name" x-test-brand-name>CookBook</span> </a><span class="step-minutes">{{ step().minutes }}</span> min</p>
 </div>
</div>
######### END FILE #########
