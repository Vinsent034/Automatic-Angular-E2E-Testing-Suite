#mutation-id: h
#element: alpha
#name: step-item-step-number
#type: tag_mov_temp_mut
#status: COMPLETE
######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\cookbook\src\app\step-item\step-item.component.html #########
<div class="step" [attr.data-step]="step().n">
  <div class="step-marker">
    
    <span class="step-dot" aria-hidden="true"></span>
  </div>
  <div class="step-content">
    <p class="step-text" [attr.x-test-step-text]="step().n">{{ step().text }}</p>
    <p class="step-time"><span class="step-minutes">{{ step().minutes }}</span> min</p>
  </div>
</div>
######### END FILE #########
######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\cookbook\src\app\toast\toast.component.html #########
@if (store.toast() !== '') {
<div class="toast-bar" role="status" aria-live="polite">
 <div class="toast-box">
  <span class="toast-icon" aria-hidden="true">i</span>
  <p class="toast-message" x-test-toast-message>{{ store.toast() }}</p>
  <button type="button" class="toast-close" aria-label="Dismiss message" (click)="store.toast.set('')"><span class="step-number" [attr.x-test-step-number]="step().n">{{ step().n }}</span>×</button>
 </div>
</div>
}
######### END FILE #########
