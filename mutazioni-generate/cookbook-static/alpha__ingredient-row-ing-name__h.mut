######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\cookbook\src\app\ingredient-row\ingredient-row.component.html #########
<div class="ingredient-row" [attr.data-ingredient-id]="ingredient().id" [class.is-optional]="ingredient().optional">
  <span class="ing-bullet" aria-hidden="true">•</span>
  <p class="ing-line">
    <span class="ing-qty" [attr.x-test-ing-qty]="ingredient().id">{{ store.formatQty(ingredient().quantity * store.scaleFactor()) }}</span>
    <span class="ing-unit">{{ ingredient().unit }}</span>
    
    <em class="ing-optional">{{ ingredient().optional ? '(optional)' : '' }}</em>
  </p>
</div>
######### END FILE #########
######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\cookbook\src\app\panel\panel.component.html #########
<section class="panel">
 <header class="panel-head">
  <h2 class="panel-heading">{{ heading() }}</h2>
  <span class="panel-note">{{ note() }}</span>
 </header>
 <div class="panel-body">
  <ng-content></ng-content>
 </div>
</section>
######### END FILE #########
