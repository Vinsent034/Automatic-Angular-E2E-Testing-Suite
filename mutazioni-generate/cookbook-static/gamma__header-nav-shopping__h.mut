######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\cookbook\src\app\header\header.component.html #########
<header class="app-header">
  <div class="header-inner">
    <div class="brand-block">
      <a class="brand-link" routerLink="/">
        <span class="brand-mark" aria-hidden="true">◆</span>
        <span class="brand-name" x-test-brand-name>CookBook</span>
      </a>
      <span class="brand-tagline">Recipe demo</span>
    </div>
    <nav class="main-nav" aria-label="Main navigation">
      
    </nav>
  </div>
</header>
######### END FILE #########
######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\cookbook\src\app\recipe-card\recipe-card.component.html #########
<ul class="nav-list">
 <li class="nav-item"><a class="nav-link" routerLink="/" routerLinkActive="active" [routerLinkActiveOptions]="{ exact: true }">Recipes</a></li>
 <li class="nav-item"><a class="nav-link" routerLink="/shopping" routerLinkActive="active" x-test-nav-shopping>Shopping</a> <span class="nav-badge" data-kind="shopping">{{ store.shoppingOpenCount() }}</span></li>
 <li class="nav-item"><a class="nav-link" routerLink="/stats" routerLinkActive="active" x-test-nav-stats>Stats</a> <span class="nav-hint">numbers</span></li>
</ul>
<article class="recipe-card" [attr.data-course]="recipe().course" [class.is-favorite]="recipe().favorite" [attr.aria-label]="'Recipe ' + recipe().title">
 <div class="card-frame">
  <div class="card-inner" [attr.data-recipe-id]="recipe().id" [attr.x-test-card]="recipe().id">
   <header class="card-head">
    <div class="card-title-row">
     <a class="card-link" [routerLink]="['/recipe', recipe().id]"> 
      <h2 class="card-title" [attr.x-test-card-title]="recipe().id">{{ recipe().title }}</h2> 
      <span class="card-course">{{ recipe().course }}</span> 
     </a>
     <button type="button" class="fav-toggle" [attr.aria-pressed]="recipe().favorite" [attr.aria-label]="'Favorite ' + recipe().title" (click)="store.toggleFavorite(recipe().id)" [attr.x-test-card-fav]="recipe().id">♥</button>
    </div>
   </header>
   <div class="card-body">
    <p class="card-facts"><span class="card-time" [attr.x-test-card-time]="recipe().id">{{ recipe().prepMinutes + recipe().cookMinutes }} min</span> <span class="card-dot">·</span> <span class="card-difficulty">{{ recipe().difficulty }}</span></p>
    <ul class="card-tags">
     @for (tag of recipe().tags; track tag) {
     <li class="tag">{{ tag }}</li>
     }
    </ul>
   </div>
  </div>
  <div class="card-ribbon">{{ recipe().vegetarian ? 'vegetarian' : 'meat or fish' }}</div>
 </div>
</article>
######### END FILE #########
