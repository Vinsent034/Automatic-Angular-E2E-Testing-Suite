######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\cookbook\src\app\stats\stats.component.html #########
<section class="stats-page">
  <div class="page-head">
    <div class="title-block">
      <h1 class="page-title" x-test-stats-title>Statistics</h1>
      <p class="page-sub">Computed from the recipes in memory</p>
    </div>
  </div>

  <div class="stat-cards">
    <div class="stat-card" data-stat="total">
      <div class="stat-body">
        <span class="stat-value" x-test-stat-total>{{ store.totalRecipes() }}</span>
        <span class="stat-label">Recipes</span>
      </div>
    </div>
    <div class="stat-card" data-stat="vegetarian">
      <div class="stat-body">
        <span class="stat-value" x-test-stat-veg>{{ store.vegetarianCount() }}</span>
        <span class="stat-label">Vegetarian</span>
      </div>
    </div>
    <div class="stat-card" data-stat="time">
      <div class="stat-body">
        <span class="stat-value" x-test-stat-time>{{ store.averageMinutes() }}</span>
        <span class="stat-label">Average minutes</span>
      </div>
    </div>
    <div class="stat-card" data-stat="favorites">
      <div class="stat-body">
        <span class="stat-value" x-test-stat-fav>{{ store.favoriteCount() }}</span>
        <span class="stat-label">Favorites</span>
      </div>
    </div>
  </div>

  <div class="stats-panels">
    <app-panel heading="Recipes by course" note="share of the whole collection">
      
    </app-panel>

    <app-panel heading="Top rated" note="best three">
      <ol class="top-list">
        @for (recipe of store.topRated(); track recipe.id) {
          <li class="top-item" [attr.data-recipe-id]="recipe.id">
            <a class="top-link" [routerLink]="['/recipe', recipe.id]" [attr.x-test-top-title]="recipe.id">{{ recipe.title }}</a>
            <span class="top-rating">★ {{ recipe.rating }}</span>
          </li>
        }
      </ol>
    </app-panel>
  </div>
</section>
######### END FILE #########
######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\cookbook\src\app\recipe-card\recipe-card.component.html #########
<article class="recipe-card" [attr.data-course]="recipe().course" [class.is-favorite]="recipe().favorite" [attr.aria-label]="'Recipe ' + recipe().title">
 <div class="card-frame">
  <div class="card-inner" [attr.data-recipe-id]="recipe().id" [attr.x-test-card]="recipe().id">
   <header class="card-head">
    <div class="card-title-row">
     <a class="card-link" [routerLink]="['/recipe', recipe().id]"> 
      <h2 class="card-title" [attr.x-test-card-title]="recipe().id">{{ recipe().title }}</h2> 
      <span class="card-course">{{ recipe().course }}</span> 
     </a>
     <button type="button" class="fav-toggle" [attr.aria-pressed]="recipe().favorite" [attr.aria-label]="'Favorite ' + recipe().title" (click)="store.toggleFavorite(recipe().id)" [attr.x-test-card-fav]="recipe().id">♥</button>
    </div>
   </header>
   <div class="card-body">
    <p class="card-facts"><span class="card-time" [attr.x-test-card-time]="recipe().id">{{ recipe().prepMinutes + recipe().cookMinutes }} min</span> <span class="card-dot">·</span> <span class="card-difficulty">{{ recipe().difficulty }}</span></p>
    <ul class="card-tags">
     @for (tag of recipe().tags; track tag) {
     <li class="tag">{{ tag }}</li>
     }
    </ul>
   </div>
  </div>
  <div class="card-ribbon">{{ recipe().vegetarian ? 'vegetarian' : 'meat or fish' }}</div>
 </div>
</article>
######### END FILE #########
