#mutation-id: LLMR_h_form_tags_del
#element: card_form_component_html
#name: h
#type: LLM_ROLE
#status: HELD
######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\Kanban board\src\app\card-form\card-form.component.html #########
<section class="form-page" x-test-card-form>
  <div class="page-heading" x-test-form-heading>
    @if (editing()) {
      <h2 class="page-title" x-test-form-title-edit>Edit card</h2>
    } @else {
      <h2 class="page-title" x-test-form-title-new>New card</h2>
    }
    <a class="btn btn-ghost back-btn" routerLink="/" x-test-form-back>Back to board</a>
  </div>

  <form class="card-form" (ngSubmit)="submit()" x-test-form>
    <div class="form-field" x-test-form-field-title>
      <label class="field-label" for="field-title" x-test-form-title-label>Title</label>
      <input id="field-title" name="title" class="input form-title" type="text" required placeholder="Card title" [(ngModel)]="title" x-test-form-title>
    </div>

    <div class="form-field" x-test-form-field-description>
      <label class="field-label" for="field-description" x-test-form-description-label>Description</label>
      <textarea id="field-description" name="description" class="input form-description" rows="4" placeholder="What is this card about?" [(ngModel)]="description" x-test-form-description></textarea>
    </div>

    <app-panel heading="Planning" note="priority, owner and column">
      <div class="form-row">
        <div class="form-field" x-test-form-field-priority>
          <label class="field-label" for="field-priority" x-test-form-priority-label>Priority</label>
          <select id="field-priority" name="priority" class="input select form-priority" [(ngModel)]="priority" x-test-form-priority>
            <option value="low">Low</option>
            <option value="medium">Medium</option>
            <option value="high">High</option>
          </select>
        </div>

        <div class="form-field" x-test-form-field-assignee>
          <label class="field-label" for="field-assignee" x-test-form-assignee-label>Assignee</label>
          <input id="field-assignee" name="assignee" class="input form-assignee" type="text" placeholder="Who works on it" [(ngModel)]="assignee" x-test-form-assignee>
        </div>

        <div class="form-field" x-test-form-field-column>
          <label class="field-label" for="field-column" x-test-form-column-label>Column</label>
          <select id="field-column" name="columnId" class="input select form-column" [(ngModel)]="columnId" x-test-form-column>
            <option value="backlog">Backlog</option>
            <option value="inprogress">In Progress</option>
            <option value="review">Review</option>
            <option value="done">Done</option>
          </select>
        </div>
      </div>
    </app-panel>

    <div class="form-field" x-test-form-field-tags>
      
      <input id="field-tags" name="tags" class="input form-tags" type="text" placeholder="e.g. bug, ui" [(ngModel)]="tagsText" x-test-form-tags>
    </div>

    <div class="form-actions" x-test-form-actions>
      <button class="btn btn-primary submit-btn" type="submit" x-test-form-submit>Save card</button>
      <a class="btn btn-ghost cancel-btn" routerLink="/" x-test-form-cancel>Cancel</a>
    </div>
  </form>
</section>
######### END FILE #########
######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\Kanban board\src\app\card-detail\card-detail.component.html #########
<section class="detail-page" x-test-card-detail>
  <div class="page-heading" x-test-detail-heading>
    <h2 class="page-title" x-test-detail-page-title>Card detail</h2>
    <a class="btn btn-ghost back-btn" routerLink="/" x-test-detail-back>Back to board</a>
  </div>

  @if (store.selectedCard()) {
    <article class="detail-card" [attr.data-card-id]="store.selectedCard()?.id" [attr.data-priority]="store.selectedCard()?.priority" x-test-detail-card>
      <header class="detail-header">
        <span class="card-id detail-id" x-test-detail-id>#{{ store.selectedCard()?.id }}</span>
        <h3 class="detail-title" x-test-detail-title>{{ store.selectedCard()?.title }}</h3>
        <span class="badge priority-badge" [attr.data-priority]="store.selectedCard()?.priority" x-test-detail-priority>{{ store.selectedCard()?.priority }}</span>
      </header>

      <app-panel heading="Details" note="card fields">
        <div class="detail-body">
          <div class="detail-row" x-test-detail-description-row>
            <span class="detail-label" x-test-detail-description-label>Description</span>
            <p class="detail-description" x-test-detail-description>{{ store.selectedCard()?.description }}</p>
          </div>

          <div class="detail-row" x-test-detail-assignee-row>
            <span class="detail-label" x-test-detail-assignee-label>Assignee</span>
            <span class="detail-assignee" [attr.data-assignee]="store.selectedCard()?.assignee" x-test-detail-assignee>{{ store.selectedCard()?.assignee }}</span>
          </div>

          <div class="detail-row" x-test-detail-column-row>
            <span class="detail-label" x-test-detail-column-label>Column</span>
            <span class="detail-column" [attr.data-column]="store.selectedCard()?.columnId" x-test-detail-column>{{ store.selectedCard()?.columnId }}</span>
          </div>

          <div class="detail-row" x-test-detail-tags-row>
            <span class="detail-label" x-test-detail-tags-label>Tags</span>
            <ul class="tag-list detail-tags" x-test-detail-tags>
              @for (tag of store.selectedCard()?.tags; track tag) {
                <li class="tag" [attr.data-tag]="tag">{{ tag }}</li>
              } @empty {
                <li class="tag tag-empty" x-test-detail-no-tags>no tags</li>
              }
            </ul>
          </div>
        </div>
      </app-panel>

      <footer class="detail-actions" x-test-detail-actions>
        <a class="btn btn-primary edit-btn" [routerLink]="['/card', store.selectedCard()?.id, 'edit']" x-test-detail-edit>Edit card</a>
        <button class="btn btn-danger delete-btn" type="button" (click)="deleteAndGoBack()" x-test-detail-delete>Delete card</button>
      </footer>
    </article>
  } @else {
    <div class="not-found" x-test-detail-not-found>
      <p class="not-found-message" x-test-detail-not-found-message>Card not found</p>
      <a class="btn btn-primary" routerLink="/" x-test-detail-not-found-back>Go to board</a>
    </div>
  }
</section>
<label class="field-label" for="field-tags" x-test-form-tags-label>Tags (comma separated)</label>
######### END FILE #########
