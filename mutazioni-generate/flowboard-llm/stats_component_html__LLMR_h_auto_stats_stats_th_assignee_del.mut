#mutation-id: LLMR_h_auto_stats_stats_th_assignee_del
#element: stats_component_html
#name: h
#type: LLM_ROLE
#status: HELD
######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\Kanban board\src\app\stats\stats.component.html #########
<section class="stats-page" x-test-stats>
  <div class="page-heading" x-test-stats-heading>
    <h2 class="page-title" x-test-stats-title>Board statistics</h2>
    <a class="btn btn-ghost back-btn" routerLink="/" x-test-stats-back>Back to board</a>
  </div>

  <div class="stats-grid" x-test-stats-cards>
    <div class="stat-card" data-stat="total" x-test-stat-total-card>
      <span class="stat-label" x-test-stat-total-label>Total cards</span>
      <span class="stat-value" x-test-stat-total>{{ store.totalCards() }}</span>
    </div>

    <div class="stat-card" data-stat="backlog" x-test-stat-backlog-card>
      <span class="stat-label" x-test-stat-backlog-label>Backlog</span>
      <span class="stat-value" x-test-stat-backlog>{{ store.backlogCount() }}</span>
    </div>

    <div class="stat-card" data-stat="inprogress" x-test-stat-inprogress-card>
      <span class="stat-label" x-test-stat-inprogress-label>In Progress</span>
      <span class="stat-value" x-test-stat-inprogress>{{ store.inProgressCount() }}</span>
    </div>

    <div class="stat-card" data-stat="review" x-test-stat-review-card>
      <span class="stat-label" x-test-stat-review-label>Review</span>
      <span class="stat-value" x-test-stat-review>{{ store.reviewCount() }}</span>
    </div>

    <div class="stat-card" data-stat="done" x-test-stat-done-card>
      <span class="stat-label" x-test-stat-done-label>Done</span>
      <span class="stat-value" x-test-stat-done>{{ store.doneCount() }}</span>
    </div>

    <div class="stat-card" data-stat="high" data-priority="high" x-test-stat-high-card>
      <span class="stat-label" x-test-stat-high-label>High priority</span>
      <span class="stat-value" x-test-stat-high>{{ store.highCount() }}</span>
    </div>

    <div class="stat-card" data-stat="medium" data-priority="medium" x-test-stat-medium-card>
      <span class="stat-label" x-test-stat-medium-label>Medium priority</span>
      <span class="stat-value" x-test-stat-medium>{{ store.mediumCount() }}</span>
    </div>

    <div class="stat-card" data-stat="low" data-priority="low" x-test-stat-low-card>
      <span class="stat-label" x-test-stat-low-label>Low priority</span>
      <span class="stat-value" x-test-stat-low>{{ store.lowCount() }}</span>
    </div>
  </div>

  <div class="stats-table-wrap" x-test-stats-table-section>
    <h3 class="section-title" x-test-stats-table-title>All cards</h3>
    <app-panel heading="Cards" note="one row per card">
      <table class="stats-table" x-test-stats-table>
        <thead>
          <tr>
            <th class="col-id" x-test-stats-th-id>Id</th>
            <th class="col-title" x-test-stats-th-title>Title</th>
            <th class="col-priority" x-test-stats-th-priority>Priority</th>
            <th class="col-assignee" x-test-stats-th-assignee>Assignee</th>
            
          </tr>
        </thead>
        <tbody>
          @for (card of store.cards(); track card.id) {
            <tr class="stats-row" [attr.data-card-id]="card.id" [attr.data-priority]="card.priority" [attr.x-test-stat-row]="card.id">
              <td class="cell-id">#{{ card.id }}</td>
              <td class="cell-title">{{ card.title }}</td>
              <td class="cell-priority">{{ card.priority }}</td>
              <td class="cell-assignee">{{ card.assignee }}</td>
              <td class="cell-column">{{ card.columnId }}</td>
            </tr>
          } @empty {
            <tr class="stats-row-empty">
              <td colspan="5" class="cell-empty" x-test-stats-empty>No cards on the board</td>
            </tr>
          }
        </tbody>
      </table>
    </app-panel>
  </div>
</section>
######### END FILE #########
######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\Kanban board\src\app\board\board.component.html #########
<section class="board-page" x-test-board>
  <div class="board-intro" x-test-board-intro>
    <h2 class="page-title" x-test-board-title>Project board</h2>
    <span class="badge badge-demo" data-kind="demo" x-test-demo-badge>Board demo</span>
    <p class="hint-banner" x-test-hint-banner>Use the Move menu on a card to change column</p>
  </div>

  <div class="toolbar" role="toolbar" aria-label="Board toolbar" x-test-toolbar>
    <div class="toolbar-group toolbar-search" role="search" x-test-toolbar-search>
      <label class="field-label" for="search-input" x-test-search-label>Search</label>
      <input id="search-input" class="input search-input" type="text" placeholder="Filter by title…" [value]="store.searchText()" (input)="onSearch($event)" x-test-search>
    </div>

    <div class="toolbar-group toolbar-priority" x-test-toolbar-priority>
      <label class="field-label" for="priority-filter" x-test-priority-label>Priority</label>
      <select id="priority-filter" class="input select priority-filter" [value]="store.priorityFilter()" (change)="onPriorityFilter($event)" x-test-filter-priority>
        <option value="all">All</option>
        <option value="low">Low</option>
        <option value="medium">Medium</option>
        <option value="high">High</option>
      </select>
    </div>

    <div class="toolbar-group toolbar-assignee" x-test-toolbar-assignee>
      <label class="field-label" for="assignee-filter" x-test-assignee-label>Assignee</label>
      <select id="assignee-filter" class="input select assignee-filter" [value]="store.assigneeFilter()" (change)="onAssigneeFilter($event)" x-test-filter-assignee>
        <option value="all">All</option>
        @for (person of store.assignees(); track person) {
          <option [value]="person">{{ person }}</option>
        }
      </select>
    </div>

    <div class="toolbar-group toolbar-info" x-test-toolbar-info>
      <span class="matching-label" x-test-matching-label>Matching</span>
      <span class="badge badge-filtered" data-kind="filtered" x-test-filtered-count>{{ store.filteredCount() }}</span>
    </div>

    <div class="toolbar-group toolbar-actions" x-test-toolbar-actions>
      <a class="btn btn-primary add-card-btn" routerLink="/card/new" role="button" x-test-add-card>Add card</a>
      <button class="btn btn-ghost reset-btn" type="button" (click)="store.reset()" x-test-reset>Reset board</button>
    </div>
  </div>

  <div class="board-grid" role="list" aria-label="Board columns" x-test-columns>
    <section class="column" data-column="backlog" role="listitem" aria-label="Backlog column" x-test-column="backlog">
      <header class="column-header">
        <h3 class="column-title" x-test-column-title="backlog">Backlog</h3>
        <span class="badge column-count" data-column="backlog" x-test-column-count="backlog">{{ store.backlogCount() }}</span>
      </header>
      <app-column colId="backlog" />
    </section>

    <section class="column" data-column="inprogress" role="listitem" aria-label="In Progress column" x-test-column="inprogress">
      <header class="column-header">
        <h3 class="column-title" x-test-column-title="inprogress">In Progress</h3>
        <span class="badge column-count" data-column="inprogress" x-test-column-count="inprogress">{{ store.inProgressCount() }}</span>
      </header>
      <app-column colId="inprogress" />
    </section>

    <section class="column" data-column="review" role="listitem" aria-label="Review column" x-test-column="review">
      <header class="column-header">
        <h3 class="column-title" x-test-column-title="review">Review</h3>
        <span class="badge column-count" data-column="review" x-test-column-count="review">{{ store.reviewCount() }}</span>
      </header>
      <app-column colId="review" />
    </section>

    <section class="column" data-column="done" role="listitem" aria-label="Done column" x-test-column="done">
      <header class="column-header">
        <h3 class="column-title" x-test-column-title="done">Done</h3>
        <span class="badge column-count" data-column="done" x-test-column-count="done">{{ store.doneCount() }}</span>
      </header>
      <app-column colId="done" />
    </section>
  </div>
</section>
<th class="col-column" x-test-stats-th-column>Column</th>
######### END FILE #########
