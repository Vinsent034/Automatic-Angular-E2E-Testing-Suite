#mutation-id: LLMP_search_component_html_a_1
#element: search_component_html
#name: a
#type: LLM_PARAMETRIC
#status: HELD
######### FILE C:\Users\vince\OneDrive\Desktop\Tirocinio\angular-spotify\libs\web\search\feature\src\lib\search.component.html #########
<div class="mb-6 content-spacing">
  <!-- Search Input -->
  <div class="search-input-container">
    <as-input class="search-control" [control]="searchControl" icon="search" [iconSize]="'xl'" placeholder="Artists, songs, albums, or playlists" [autoFocus]="true" [rounded]="true" [enableClearButton]="true">
    </as-input>
    @if (isLoading$ | async) {
      
    }
  </div>

  <!-- Tracks -->
  @if (tracks$ | async; as tracks) {
    @if (tracks.length) {
      <div>
        <h2 class="mt-8 mb-4 text-heading">Songs</h2>
        <as-media-table-header>
          <div class="album-tracks-grid">
            <div>#</div>
            <div class="text-xs uppercase ellipsis-one-line">Title</div>
            <svg-icon [key]="'clock'" title="Duration"></svg-icon>
          </div>
        </as-media-table-header>
        <div class="mb-8">
          @for (item of tracks; track item; let idx = $index) {
            <as-album-track [track]="item" [contextUri]="item.album.uri" [index]="idx + 1">
            </as-album-track>
          }
        </div>
      </div>
    }
  }
  <!-- Artists -->
  @if (artists$ | async; as artists) {
    @if (artists.length) {
      <div>
        <h2 class="mt-8 mb-4 text-heading">Artists</h2>
        <div class="common-grid">
          @for (item of artists; track item) {
            <as-card [title]="item.name" [uri]="item.uri" [imageUrl]="item.images?.[0]?.url" [routerUrl]="'/artist/' + item.id" [description]="item.type | titlecase" [roundedImage]="true" (togglePlay)="togglePlay($event, item.uri)">
            </as-card>
          }
        </div>
      </div>
    }
  }
  <!-- Albums -->
  @if (albums$ | async; as albums) {
    @if (albums.length) {
      <div>
        <h2 class="mt-8 mb-4 text-heading">Albums</h2>
        <div class="common-grid">
          @for (item of albums; track item) {
            <as-card [title]="item.name" [uri]="item.uri" [description]="item.artists[0].name" [imageUrl]="item.images?.[0]?.url" [routerUrl]="'/albums/' + item.id" (togglePlay)="togglePlay($event, item.uri)">
            </as-card>
          }
        </div>
      </div>
    }
  }
  <!-- Playlists -->
  @if (playlists$ | async; as playlists) {
    @if (playlists.length) {
      <div>
        <h2 class="mt-8 mb-4 text-heading">Playlists</h2>
        <div class="common-grid">
          @for (item of playlists; track item) {
            <as-card [title]="item.name" [uri]="item.uri" [description]="item.description" [imageUrl]="item.images?.[0]?.url" [routerUrl]="'/playlist/' + item.id" (togglePlay)="togglePlay($event, item.uri)">
            </as-card>
          }
        </div>
      </div>
    }
  }

  <!-- Infinite scroll sentinel -->
  <div asInfiniteScroll [enabled]="(hasMore$ | async) === true &amp;&amp; (isLoading$ | async) === false" (scrolledToBottom)="loadMore()">
  </div>
</div>
######### END FILE #########
