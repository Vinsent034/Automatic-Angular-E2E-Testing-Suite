#mutation-id: LLMR_h_genre_row_gam
#element: stats_component_html
#name: h
#type: LLM_ROLE
#status: COMPLETE
######### FILE C:\Users\vince\OneDrive\Desktop\App tirocinio\cinelib\src\app\stats\stats.component.html #########
<section class="stats-page" x-test-stats>
  <h1 class="form-heading" x-test-stats-heading>Statistics</h1>

  <div class="stat-cards" x-test-stat-cards>
    <div class="stat-card" x-test-stat-total>
      <span class="stat-value" x-test-stat-total-value>{{ total() }}</span>
      <span class="stat-label">Movies</span>
    </div>
    <div class="stat-card" x-test-stat-average>
      <span class="stat-value" x-test-stat-average-value>★ {{ averageRating() }}</span>
      <span class="stat-label">Average rating</span>
    </div>
    <div class="stat-card" x-test-stat-runtime>
      <span class="stat-value" x-test-stat-runtime-value>{{ averageRuntime() }}'</span>
      <span class="stat-label">Average runtime</span>
    </div>
    <div class="stat-card" x-test-stat-favorites>
      <span class="stat-value" x-test-stat-favorites-value>{{ favoriteCount() }}</span>
      <span class="stat-label">Favorites</span>
    </div>
    <div class="stat-card" x-test-stat-reviews>
      <span class="stat-value" x-test-stat-reviews-value>{{ reviewCount() }}</span>
      <span class="stat-label">Reviews</span>
    </div>
  </div>

  

  <section class="detail-section">
    <h2 class="section-title">Top rated</h2>
    <table class="stats-table" x-test-top-table>
      <thead>
        <tr>
          <th>#</th>
          <th>Title</th>
          <th>Year</th>
          <th>Rating</th>
        </tr>
      </thead>
      <tbody>
        @for (movie of topRated(); track movie.id; let i = $index) {
          <tr x-test-top-row>
            <td>{{ i + 1 }}</td>
            <td><a [routerLink]="['/movie', movie.id]" class="stats-link" x-test-top-title>{{ movie.title }}</a></td>
            <td>{{ movie.year }}</td>
            <td class="stats-rating">★ {{ movie.rating }}</td>
          </tr>
        }
      </tbody>
    </table>
  </section>
</section>
######### END FILE #########
######### FILE C:\Users\vince\OneDrive\Desktop\App tirocinio\cinelib\src\app\catalog\catalog.component.html #########
<section class="catalog" x-test-catalog>
  <div class="toolbar">
    <div class="search-box">
      <input type="text" class="search-input" placeholder="Search a movie…" [value]="query()" (input)="onSearch($any($event.target).value)" x-test-search-input>
    </div>
    <select class="field-input filter-select" [value]="genre()" (change)="onGenre($any($event.target).value)" x-test-filter-genre>
      <option value="">All genres</option>
      @for (g of genres(); track g) {
        <option [value]="g">{{ g }}</option>
      }
    </select>
    <select class="field-input filter-select" [value]="sort()" (change)="onSort($any($event.target).value)" x-test-sort>
      <option value="title">Title (A–Z)</option>
      <option value="rating">Top rated</option>
      <option value="year">Newest</option>
    </select>
    <a routerLink="/movie/new" class="btn btn-primary" x-test-add-button>Add movie</a>
  </div>

  <div class="toolbar toolbar-secondary">
    <button type="button" class="btn btn-toggle" [class.active]="favoritesOnly()" [attr.aria-pressed]="favoritesOnly()" (click)="toggleFavoritesOnly()" x-test-favorites-filter>♥ Favorites ({{ favoriteCount() }})</button>

    <div class="view-switch" role="group" aria-label="View mode" x-test-view-switch>
      <button type="button" class="view-btn" [class.active]="view() === 'grid'" [attr.aria-pressed]="view() === 'grid'" (click)="setView('grid')" x-test-view-grid>Grid</button>
      <button type="button" class="view-btn" [class.active]="view() === 'list'" [attr.aria-pressed]="view() === 'list'" (click)="setView('list')" x-test-view-list>List</button>
    </div>

    <button type="button" class="btn btn-ghost" (click)="openReset()" x-test-reset-button>Reset catalog</button>
  </div>

  @if (movies().length > 0) {
    <p class="result-count" x-test-result-count>{{ movies().length }} {{ movies().length === 1 ? 'movie' : 'movies' }}</p>
    <div class="movie-grid movie-grid-{{ view() }}" x-test-grid>
      @for (movie of movies(); track movie.id) {
        <app-movie-card [movie]="movie" [view]="view()"></app-movie-card>
      }
    </div>
  } @else {
    <p class="empty-state" x-test-empty>No movies match your search.</p>
  }
</section>

@if (resetOpen()) {
  <div class="modal-backdrop" x-test-modal-backdrop>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="reset-title" x-test-reset-modal>
      <h2 id="reset-title" class="modal-title" x-test-modal-title>Reset catalog?</h2>
      <p class="modal-body" x-test-modal-body>
        This restores the original sample movies and discards every change, favorite and review.
      </p>
      <div class="modal-actions">
        <button type="button" class="btn btn-danger" (click)="confirmReset()" x-test-modal-confirm>Reset</button>
        <button type="button" class="btn" (click)="cancelReset()" x-test-modal-cancel>Cancel</button>
      </div>
    </div>
  </div>
}
<section class="detail-section">
    <h2 class="section-title">Movies by genre</h2>
    <div class="genre-bars" x-test-genre-bars>
      @for (g of genreStats(); track g.genre) {
        <div class="genre-bar-row" x-test-genre-row [attr.data-genre]="g.genre">
          <span class="genre-bar-label" x-test-genre-label>{{ g.genre }}</span>
          <div class="genre-bar-track">
            <div class="genre-bar-fill" [style.width.%]="g.share"></div>
          </div>
          <span class="genre-bar-count" x-test-genre-count>{{ g.count }}</span>
        </div>
      }
    </div>
  </section>
######### END FILE #########
