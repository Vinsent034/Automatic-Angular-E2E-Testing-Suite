#mutation-id: LLMR_h_review_item_bet
#element: reviews_component_html
#name: h
#type: LLM_ROLE
#status: HELD
######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\cinelib\src\app\reviews\reviews.component.html #########
<div class="reviews" x-test-reviews>
  <div class="reviews-summary" x-test-reviews-summary>
    @if (reviews().length > 0) {
      <span class="reviews-average" x-test-reviews-average>★ {{ averageUserRating() }}</span>
      <span class="reviews-count" x-test-reviews-count>
        {{ reviews().length }} {{ reviews().length === 1 ? 'review' : 'reviews' }}
      </span>
    } @else {
      <span class="reviews-count" x-test-reviews-empty>No reviews yet — be the first.</span>
    }
  </div>

  

  <form [formGroup]="form" (ngSubmit)="submit()" class="review-form" x-test-review-form>
    <div class="review-form-row">
      <div class="field">
        <label for="review-author" class="field-label">Your name</label>
        <input id="review-author" type="text" formControlName="author" class="field-input" x-test-review-field-author>
        @if (showError('author')) {
          <p class="field-error" x-test-review-error-author>Name is required.</p>
        }
      </div>
      <div class="field">
        <label for="review-rating" class="field-label">Rating</label>
        <select id="review-rating" formControlName="rating" class="field-input" x-test-review-field-rating>
          @for (r of ratings; track r) {
            <option [value]="r">{{ r }} ★</option>
          }
        </select>
      </div>
    </div>
    <div class="field">
      <label for="review-comment" class="field-label">Comment</label>
      <textarea id="review-comment" formControlName="comment" rows="3" class="field-input" x-test-review-field-comment></textarea>
      @if (showError('comment')) {
        <p class="field-error" x-test-review-error-comment>Write at least 3 characters.</p>
      }
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary" x-test-review-submit>Post review</button>
    </div>
  </form>
</div>
######### END FILE #########
######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\cinelib\src\app\movie-detail\movie-detail.component.html #########
@if (movie(); as m) {
  <article class="movie-detail" x-test-detail>
    <app-panel heading="Overview" note="title, details and actions">
      <header class="detail-header">
        <div class="detail-poster" aria-hidden="true">
          <span class="poster-letter">{{ m.title.charAt(0) }}</span>
        </div>
        <div class="detail-info">
          <p class="detail-kicker">Movie</p>
          <h1 class="detail-title" x-test-detail-title>{{ m.title }}</h1>
          <p class="detail-meta" x-test-detail-meta>{{ m.year }} · {{ m.genre }} · {{ m.runtime }} min · ★ {{ m.rating }}</p>
          <p class="detail-director">Directed by {{ m.director }}</p>
          <div class="detail-actions">
            <button type="button" class="btn btn-favorite" [class.active]="m.favorite" [attr.aria-pressed]="m.favorite" (click)="toggleFavorite()" x-test-detail-favorite>{{ m.favorite ? '♥ In favorites' : '♡ Add to favorites' }}</button>
            <a [routerLink]="['/movie', m.id, 'edit']" class="btn" x-test-edit-button>Edit</a>
            <button type="button" class="btn btn-danger" (click)="openDelete()" x-test-delete-button>Delete</button>
          </div>
        </div>
      </header>
    </app-panel>

    <section class="detail-section">
      <h2 class="section-title">Synopsis</h2>
      <p class="synopsis-text" x-test-synopsis>{{ m.synopsis }}</p>
    </section>

    <section class="detail-section">
      <h2 class="section-title">Cast</h2>
      <div class="cast-list" x-test-cast-list>
        @for (member of m.cast; track member.name) {
          <app-cast-row [member]="member"></app-cast-row>
        }
      </div>
    </section>

    <section class="detail-section">
      <h2 class="section-title">Reviews</h2>
      <app-reviews [movie]="m"></app-reviews>
    </section>
  </article>

  @if (confirmOpen()) {
    <div class="modal-backdrop" x-test-modal-backdrop>
      <div class="modal" role="dialog" aria-modal="true" aria-labelledby="delete-title" x-test-delete-modal>
        <h2 id="delete-title" class="modal-title" x-test-modal-title>Delete “{{ m.title }}”?</h2>
        <p class="modal-body" x-test-modal-body>This cannot be undone.</p>
        <div class="modal-actions">
          <button type="button" class="btn btn-danger" (click)="confirmDelete()" x-test-modal-confirm>Delete</button>
          <button type="button" class="btn" (click)="cancelDelete()" x-test-modal-cancel>Cancel</button>
        </div>
      </div>
    </div>
  }
} @else {
  <p class="empty-state" x-test-not-found>
    Movie not found. <a routerLink="/">Back to catalog</a>
  </p>
}
<ul class="review-list" x-test-review-list>
    @for (review of reviews(); track review.id) {
      <li class="review-item" x-test-review-item>
        <div class="review-head">
          <span class="review-author" x-test-review-author>{{ review.author }}</span>
          <span class="review-stars" x-test-review-stars [attr.data-rating]="review.rating">{{ stars(review.rating) }}</span>
          <span class="review-date" x-test-review-date>{{ review.date }}</span>
          <button type="button" class="review-remove" (click)="remove(review.id)" aria-label="Remove review" x-test-review-remove>×</button>
        </div>
        <p class="review-comment" x-test-review-comment>{{ review.comment }}</p>
      </li>
    }
  </ul>
######### END FILE #########
