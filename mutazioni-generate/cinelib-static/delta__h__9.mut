#mutation-id: h
#element: delta
#name: card-favorite-toggle
#type: tag_mov_temp_mut
#status: COMPLETE
######### FILE C:\Users\vince\OneDrive\Desktop\App tirocinio\cinelib\src\app\movie-card\movie-card.component.html #########
<div class="movie-card movie-card-{{ view() }}" [attr.data-genre]="movie().genre" [class.is-favorite]="movie().favorite" x-test-card>
  <a class="poster" [routerLink]="['/movie', movie().id]" aria-hidden="true" tabindex="-1" x-test-card-poster>
    <span class="poster-letter">{{ movie().title.charAt(0) }}</span>
  </a>
  <button type="button" class="favorite-toggle" [class.active]="movie().favorite" (click)="toggleFavorite()" [attr.aria-pressed]="movie().favorite" [attr.aria-label]="movie().favorite ? 'Remove from favorites' : 'Add to favorites'" x-test-favorite-toggle>{{ movie().favorite ? '♥' : '♡' }}</button>
  
</div>
######### END FILE #########
######### FILE C:\Users\vince\OneDrive\Desktop\App tirocinio\cinelib\src\app\app.component.html #########
