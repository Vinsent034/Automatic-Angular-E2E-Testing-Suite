#mutation-id: h
#element: alpha
#name: top-title
#type: tag_mov_temp_mut
#status: COMPLETE
######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\cinelib\src\app\stats\stats.component.html #########
<section class="stats-page" x-test-stats>
  <h1 class="form-heading" x-test-stats-heading>Statistics</h1>

  <div class="stat-cards" x-test-stat-cards>
    <div class="stat-card" x-test-stat-total>
      <span class="stat-value" x-test-stat-total-value>{{ total() }}</span>
      <span class="stat-label">Movies</span>
    </div>
    <div class="stat-card" x-test-stat-average>
      <span class="stat-value" x-test-stat-average-value>★ {{ averageRating() }}</span>
      <span class="stat-label">Average rating</span>
    </div>
    <div class="stat-card" x-test-stat-runtime>
      <span class="stat-value" x-test-stat-runtime-value>{{ averageRuntime() }}'</span>
      <span class="stat-label">Average runtime</span>
    </div>
    <div class="stat-card" x-test-stat-favorites>
      <span class="stat-value" x-test-stat-favorites-value>{{ favoriteCount() }}</span>
      <span class="stat-label">Favorites</span>
    </div>
    <div class="stat-card" x-test-stat-reviews>
      <span class="stat-value" x-test-stat-reviews-value>{{ reviewCount() }}</span>
      <span class="stat-label">Reviews</span>
    </div>
  </div>

  <section class="detail-section">
    <h2 class="section-title">Movies by genre</h2>
    <app-panel heading="Genres" note="share of the catalog">
      <div class="genre-bars" x-test-genre-bars>
        @for (g of genreStats(); track g.genre) {
          <div class="genre-bar-row" x-test-genre-row [attr.data-genre]="g.genre">
            <span class="genre-bar-label" x-test-genre-label>{{ g.genre }}</span>
            <div class="genre-bar-track">
              <div class="genre-bar-fill" [style.width.%]="g.share"></div>
            </div>
            <span class="genre-bar-count" x-test-genre-count>{{ g.count }}</span>
          </div>
        }
      </div>
    </app-panel>
  </section>

  <section class="detail-section">
    <h2 class="section-title">Top rated</h2>
    <app-panel heading="Ranking" note="best rated first">
      <table class="stats-table" x-test-top-table>
        <thead>
          <tr>
            <th>#</th>
            <th>Title</th>
            <th>Year</th>
            <th>Rating</th>
          </tr>
        </thead>
        <tbody>
          @for (movie of topRated(); track movie.id; let i = $index) {
            <tr x-test-top-row>
              <td>{{ i + 1 }}</td>
              <td></td>
              <td>{{ movie.year }}</td>
              <td class="stats-rating">★ {{ movie.rating }}</td>
            </tr>
          }
        </tbody>
      </table>
    </app-panel>
  </section>
</section>
######### END FILE #########
######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\cinelib\src\app\movie-card\movie-card.component.html #########
<div class="movie-card movie-card-{{ view() }}" [attr.data-genre]="movie().genre" [class.is-favorite]="movie().favorite" x-test-card>
 <a class="poster" [routerLink]="['/movie', movie().id]" aria-hidden="true" tabindex="-1" x-test-card-poster> <span class="poster-letter">{{ movie().title.charAt(0) }}</span> </a>
 <button type="button" class="favorite-toggle" [class.active]="movie().favorite" (click)="toggleFavorite()" [attr.aria-pressed]="movie().favorite" [attr.aria-label]="movie().favorite ? 'Remove from favorites' : 'Add to favorites'" x-test-favorite-toggle>{{ movie().favorite ? '♥' : '♡' }}</button>
 <div class="card-body">
  <a class="card-title-link" [routerLink]="['/movie', movie().id]" x-test-card-link> 
   <h2 class="card-title" x-test-card-title>{{ movie().title }}</h2> 
  </a>
  <p class="card-meta" x-test-card-meta><a [routerLink]="['/movie', movie.id]" class="stats-link" x-test-top-title>{{ movie.title }}</a>{{ movie().year }} · {{ movie().genre }}</p>
  <p class="card-rating" x-test-card-rating>★ {{ movie().rating }}</p>
 </div>
</div>
######### END FILE #########
