#mutation-id: h
#element: beta
#name: catalog-search-input
#type: tag_mov_temp_mut
#status: COMPLETE
######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\cinelib\src\app\catalog\catalog.component.html #########
<section class="catalog" x-test-catalog>
  <div class="toolbar">
    
    <select class="field-input filter-select" [value]="genre()" (change)="onGenre($any($event.target).value)" x-test-filter-genre>
      <option value="">All genres</option>
      @for (g of genres(); track g) {
        <option [value]="g">{{ g }}</option>
      }
    </select>
    <select class="field-input filter-select" [value]="sort()" (change)="onSort($any($event.target).value)" x-test-sort>
      <option value="title">Title (A–Z)</option>
      <option value="rating">Top rated</option>
      <option value="year">Newest</option>
    </select>
    <a routerLink="/movie/new" class="btn btn-primary" x-test-add-button>Add movie</a>
  </div>

  <div class="toolbar toolbar-secondary">
    <button type="button" class="btn btn-toggle" [class.active]="favoritesOnly()" [attr.aria-pressed]="favoritesOnly()" (click)="toggleFavoritesOnly()" x-test-favorites-filter>♥ Favorites ({{ favoriteCount() }})</button>

    <div class="view-switch" role="group" aria-label="View mode" x-test-view-switch>
      <button type="button" class="view-btn" [class.active]="view() === 'grid'" [attr.aria-pressed]="view() === 'grid'" (click)="setView('grid')" x-test-view-grid>Grid</button>
      <button type="button" class="view-btn" [class.active]="view() === 'list'" [attr.aria-pressed]="view() === 'list'" (click)="setView('list')" x-test-view-list>List</button>
    </div>

    <button type="button" class="btn btn-ghost" (click)="openReset()" x-test-reset-button>Reset catalog</button>
  </div>

  @if (movies().length > 0) {
    <p class="result-count" x-test-result-count>{{ movies().length }} {{ movies().length === 1 ? 'movie' : 'movies' }}</p>
    <div class="movie-grid movie-grid-{{ view() }}" x-test-grid>
      @for (movie of movies(); track movie.id) {
        <app-movie-card [movie]="movie" [view]="view()"></app-movie-card>
      }
    </div>
  } @else {
    <p class="empty-state" x-test-empty>No movies match your search.</p>
  }
</section>

@if (resetOpen()) {
  <div class="modal-backdrop" x-test-modal-backdrop>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="reset-title" x-test-reset-modal>
      <h2 id="reset-title" class="modal-title" x-test-modal-title>Reset catalog?</h2>
      <p class="modal-body" x-test-modal-body>
        This restores the original sample movies and discards every change, favorite and review.
      </p>
      <div class="modal-actions">
        <button type="button" class="btn btn-danger" (click)="confirmReset()" x-test-modal-confirm>Reset</button>
        <button type="button" class="btn" (click)="cancelReset()" x-test-modal-cancel>Cancel</button>
      </div>
    </div>
  </div>
}
######### END FILE #########
######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\cinelib\src\app\reviews\reviews.component.html #########
<div class="reviews" x-test-reviews>
 <div class="reviews-summary" x-test-reviews-summary>
  @if (reviews().length > 0) { <span class="reviews-average" x-test-reviews-average>★ {{ averageUserRating() }}</span> <span class="reviews-count" x-test-reviews-count> {{ reviews().length }} {{ reviews().length === 1 ? 'review' : 'reviews' }} </span> } @else { <span class="reviews-count" x-test-reviews-empty>No reviews yet — be the first.</span> }
 </div>
 <ul class="review-list" x-test-review-list>
  @for (review of reviews(); track review.id) {
  <li class="review-item" x-test-review-item>
   <div class="review-head">
    <span class="review-author" x-test-review-author>{{ review.author }}</span> <span class="review-stars" x-test-review-stars [attr.data-rating]="review.rating">{{ stars(review.rating) }}</span> <span class="review-date" x-test-review-date>{{ review.date }}</span>
    <button type="button" class="review-remove" (click)="remove(review.id)" aria-label="Remove review" x-test-review-remove>×</button>
   </div>
   <p class="review-comment" x-test-review-comment>{{ review.comment }}</p>
  </li>
  }
 </ul>
 <form [formGroup]="form" (ngSubmit)="submit()" class="review-form" x-test-review-form>
  <div class="review-form-row">
   <div class="field">
    <label for="review-author" class="field-label">Your name</label> <input id="review-author" type="text" formControlName="author" class="field-input" x-test-review-field-author> @if (showError('author')) {
    <p class="field-error" x-test-review-error-author>Name is required.</p>
    }
   </div>
   <div class="field">
    <label for="review-rating" class="field-label">Rating</label> <select id="review-rating" formControlName="rating" class="field-input" x-test-review-field-rating> @for (r of ratings; track r) { <option [value]="r">{{ r }} ★</option> } </select>
   </div>
  </div>
  <div class="field">
   <label for="review-comment" class="field-label">Comment</label> <textarea id="review-comment" formControlName="comment" rows="3" class="field-input" x-test-review-field-comment></textarea> @if (showError('comment')) {
   <p class="field-error" x-test-review-error-comment>Write at least 3 characters.</p>
   }
  </div>
  <div class="form-actions">
   <button type="submit" class="btn btn-primary" x-test-review-submit>Post review</button>
  </div>
 </form>
</div>
######### END FILE #########
