#mutation-id: h
#element: beta
#name: catalog-reset-button
#type: tag_mov_temp_mut
#status: COMPLETE
######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\cinelib\src\app\catalog\catalog.component.html #########
<section class="catalog" x-test-catalog>
  <div class="toolbar">
    <div class="search-box">
      <input type="text" class="search-input" placeholder="Search a movie…" [value]="query()" (input)="onSearch($any($event.target).value)" x-test-search-input>
    </div>
    <select class="field-input filter-select" [value]="genre()" (change)="onGenre($any($event.target).value)" x-test-filter-genre>
      <option value="">All genres</option>
      @for (g of genres(); track g) {
        <option [value]="g">{{ g }}</option>
      }
    </select>
    <select class="field-input filter-select" [value]="sort()" (change)="onSort($any($event.target).value)" x-test-sort>
      <option value="title">Title (A–Z)</option>
      <option value="rating">Top rated</option>
      <option value="year">Newest</option>
    </select>
    <a routerLink="/movie/new" class="btn btn-primary" x-test-add-button>Add movie</a>
  </div>

  

  @if (movies().length > 0) {
    <p class="result-count" x-test-result-count>{{ movies().length }} {{ movies().length === 1 ? 'movie' : 'movies' }}</p>
    <div class="movie-grid movie-grid-{{ view() }}" x-test-grid>
      @for (movie of movies(); track movie.id) {
        <app-movie-card [movie]="movie" [view]="view()"></app-movie-card>
      }
    </div>
  } @else {
    <p class="empty-state" x-test-empty>No movies match your search.</p>
  }
</section>

@if (resetOpen()) {
  <div class="modal-backdrop" x-test-modal-backdrop>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="reset-title" x-test-reset-modal>
      <h2 id="reset-title" class="modal-title" x-test-modal-title>Reset catalog?</h2>
      <p class="modal-body" x-test-modal-body>
        This restores the original sample movies and discards every change, favorite and review.
      </p>
      <div class="modal-actions">
        <button type="button" class="btn btn-danger" (click)="confirmReset()" x-test-modal-confirm>Reset</button>
        <button type="button" class="btn" (click)="cancelReset()" x-test-modal-cancel>Cancel</button>
      </div>
    </div>
  </div>
}
######### END FILE #########
######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\cinelib\src\app\toast\toast.component.html #########
@if (toasts().length > 0) {
<div class="toast-stack" x-test-toast-stack>
 @for (toast of toasts(); track toast.id) {
 <div class="toast toast-{{ toast.kind }}" role="status" [attr.data-kind]="toast.kind" x-test-toast>
  <span class="toast-message" x-test-toast-message>{{ toast.message }}</span>
  <button type="button" class="toast-close" (click)="dismiss(toast.id)" aria-label="Dismiss" x-test-toast-close>×</button>
 </div>
 }
</div>
}
######### END FILE #########
