#mutation-id: h
#element: alpha
#name: reviews-average
#type: tag_mov_temp_mut
#status: COMPLETE
######### FILE C:\Users\vince\OneDrive\Desktop\App tirocinio\cinelib\src\app\reviews\reviews.component.html #########
<div class="reviews" x-test-reviews>
  <div class="reviews-summary" x-test-reviews-summary>
    @if (reviews().length > 0) {
      
      <span class="reviews-count" x-test-reviews-count>
        {{ reviews().length }} {{ reviews().length === 1 ? 'review' : 'reviews' }}
      </span>
    } @else {
      <span class="reviews-count" x-test-reviews-empty>No reviews yet — be the first.</span>
    }
  </div>

  <ul class="review-list" x-test-review-list>
    @for (review of reviews(); track review.id) {
      <li class="review-item" x-test-review-item>
        <div class="review-head">
          <span class="review-author" x-test-review-author>{{ review.author }}</span>
          <span class="review-stars" x-test-review-stars [attr.data-rating]="review.rating">{{ stars(review.rating) }}</span>
          <span class="review-date" x-test-review-date>{{ review.date }}</span>
          <button type="button" class="review-remove" (click)="remove(review.id)" aria-label="Remove review" x-test-review-remove>×</button>
        </div>
        <p class="review-comment" x-test-review-comment>{{ review.comment }}</p>
      </li>
    }
  </ul>

  <form [formGroup]="form" (ngSubmit)="submit()" class="review-form" x-test-review-form>
    <div class="review-form-row">
      <div class="field">
        <label for="review-author" class="field-label">Your name</label>
        <input id="review-author" type="text" formControlName="author" class="field-input" x-test-review-field-author>
        @if (showError('author')) {
          <p class="field-error" x-test-review-error-author>Name is required.</p>
        }
      </div>
      <div class="field">
        <label for="review-rating" class="field-label">Rating</label>
        <select id="review-rating" formControlName="rating" class="field-input" x-test-review-field-rating>
          @for (r of ratings; track r) {
            <option [value]="r">{{ r }} ★</option>
          }
        </select>
      </div>
    </div>
    <div class="field">
      <label for="review-comment" class="field-label">Comment</label>
      <textarea id="review-comment" formControlName="comment" rows="3" class="field-input" x-test-review-field-comment></textarea>
      @if (showError('comment')) {
        <p class="field-error" x-test-review-error-comment>Write at least 3 characters.</p>
      }
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary" x-test-review-submit>Post review</button>
    </div>
  </form>
</div>
######### END FILE #########
######### FILE C:\Users\vince\OneDrive\Desktop\App tirocinio\cinelib\src\app\movie-form\movie-form.component.html #########
<section class="form-page" x-test-form-page>
 <h1 class="form-heading" x-test-form-heading>{{ isEdit ? 'Edit movie' : 'Add movie' }}</h1>
 <form [formGroup]="form" (ngSubmit)="save()" class="movie-form" x-test-form>
  <div class="field">
   <label for="title" class="field-label">Title</label> <input id="title" type="text" formControlName="title" class="field-input" x-test-field-title> @if (showError('title')) {
   <p class="field-error" x-test-error-title>Title is required.</p>
   }
  </div>
  <div class="field-row">
   <div class="field">
    <label for="year" class="field-label">Year</label> <input id="year" type="number" formControlName="year" class="field-input" x-test-field-year> @if (showError('year')) {
    <p class="field-error" x-test-error-year>Enter a year between 1900 and 2100.</p>
    }
   </div>
   <div class="field">
    <label for="genre" class="field-label">Genre</label> <select id="genre" formControlName="genre" class="field-input" x-test-field-genre> @for (g of genres; track g) { <option [value]="g">{{ g }}</option> } </select>
   </div>
   <div class="field">
    <label for="rating" class="field-label">Rating</label> <input id="rating" type="number" step="0.1" formControlName="rating" class="field-input" x-test-field-rating> @if (showError('rating')) {
    <p class="field-error" x-test-error-rating>Rating must be between 0 and 5.</p>
    }
   </div>
  </div>
  <div class="field">
   <label for="runtime" class="field-label">Runtime (minutes)</label> <input id="runtime" type="number" formControlName="runtime" class="field-input" x-test-field-runtime> @if (showError('runtime')) {
   <p class="field-error" x-test-error-runtime>Runtime must be between 1 and 600 minutes.</p>
   }
  </div>
  <div class="field">
   <label for="director" class="field-label">Director</label> <input id="director" type="text" formControlName="director" class="field-input" x-test-field-director> @if (showError('director')) {
   <p class="field-error" x-test-error-director>Director is required.</p>
   }
  </div>
  <div class="field">
   <label for="synopsis" class="field-label">Synopsis</label> <textarea id="synopsis" formControlName="synopsis" rows="4" class="field-input" x-test-field-synopsis></textarea>
  </div>
  <div class="field">
   <div class="cast-header">
    <span class="field-label">Cast</span>
    <button type="button" class="btn btn-small" (click)="addCast()" x-test-cast-add>+ Add member</button>
   </div>
   <div formArrayName="cast" class="cast-editor" x-test-cast-editor>
    @for (member of cast.controls; track $index) {
    <div class="cast-edit-row" [formGroupName]="$index" x-test-cast-edit-row>
     <input type="text" formControlName="name" placeholder="Actor name" class="field-input" x-test-cast-name> <input type="text" formControlName="role" placeholder="Role" class="field-input" x-test-cast-role>
     <button type="button" class="btn btn-danger btn-small" (click)="removeCast($index)" x-test-cast-remove>Remove</button>
    </div>
    } @empty {
    <p class="cast-empty">No cast members yet.</p>
    }
   </div>
  </div>
  <div class="form-actions">
   <button type="submit" class="btn btn-primary" x-test-form-submit>{{ isEdit ? 'Save changes' : 'Create movie' }}</button>
   <button type="button" class="btn" (click)="cancel()" x-test-form-cancel>Cancel</button>
  </div>
 </form>
</section>
######### END FILE #########
