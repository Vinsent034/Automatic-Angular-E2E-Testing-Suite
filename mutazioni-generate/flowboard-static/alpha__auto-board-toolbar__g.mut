#mutation-id: g
#element: alpha
#name: auto-board-toolbar
#type: tag_mov_html_mut
#status: COMPLETE
######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\Kanban board\src\app\board\board.component.html #########
<section class="board-page" x-test-board>
  <div class="board-intro" x-test-board-intro>
    <h2 class="page-title" x-test-board-title>Project board</h2>
    <span class="badge badge-demo" data-kind="demo" x-test-demo-badge>Board demo</span>
    <p class="hint-banner" x-test-hint-banner>Use the Move menu on a card to change column</p>
  </div>

  

  <div class="board-grid" role="list" aria-label="Board columns" x-test-columns>
    <section class="column" data-column="backlog" role="listitem" aria-label="Backlog column" x-test-column="backlog">
      <header class="column-header">
        <h3 class="column-title" x-test-column-title="backlog">Backlog</h3>
        <span class="badge column-count" data-column="backlog" x-test-column-count="backlog">{{ store.backlogCount() }}</span>
      </header>
      <app-column colId="backlog">
    </app-column></section>

    <section class="column" data-column="inprogress" role="listitem" aria-label="In Progress column" x-test-column="inprogress">
      <header class="column-header">
        <h3 class="column-title" x-test-column-title="inprogress">In Progress</h3>
        <span class="badge column-count" data-column="inprogress" x-test-column-count="inprogress">{{ store.inProgressCount() }}</span>
      </header>
      <app-column colId="inprogress">
    </app-column></section>

    <section class="column" data-column="review" role="listitem" aria-label="Review column" x-test-column="review">
      <header class="column-header">
        <h3 class="column-title" x-test-column-title="review">Review</h3>
        <span class="badge column-count" data-column="review" x-test-column-count="review">{{ store.reviewCount() }}</span>
      </header>
      <app-column colId="review">
    </app-column></section>

    <section class="column" data-column="done" role="listitem" aria-label="Done column" x-test-column="done">
      <header class="column-header">
        <h3 class="column-title" x-test-column-title="done">Done</h3>
        <span class="badge column-count" data-column="done" x-test-column-count="done">{{ store.doneCount() }}</span>
      </header>
      <app-column colId="done">
    </app-column></section>
  </div>
</section>
######### END FILE #########
######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\Kanban board\src\app\card\card.component.html #########
<article class="card" [attr.data-card-id]="card().id" [attr.data-priority]="card().priority" [attr.data-column]="card().columnId" [attr.aria-label]="'Card ' + card().title" [attr.x-test-card]="card().id">
 <header class="card-top">
  <span class="card-id" [attr.x-test-card-id]="card().id">#{{ card().id }}</span> <span class="badge priority-badge" [attr.data-priority]="card().priority" [attr.x-test-card-priority]="card().id">{{ card().priority }}</span>
 </header>
 <a class="card-title-link" [routerLink]="['/card', card().id]" [attr.x-test-card-open]="card().id"> 
  <h4 class="card-title" [attr.x-test-card-title]="card().id">{{ card().title }}</h4> 
 </a>
 <div class="card-meta">
  <span class="card-assignee" [attr.data-assignee]="card().assignee" [attr.x-test-card-assignee]="card().id">{{ card().assignee }}</span>
  <ul class="tag-list" [attr.x-test-card-tags]="card().id">
   @for (tag of card().tags; track tag) {
   <li class="tag" [attr.data-tag]="tag">{{ tag }}</li>
   }
  </ul>
 </div>
 <footer class="card-actions">
  <label class="move-label"> <span class="move-caption">Move</span> <select class="input select move-select" [value]="card().columnId" (change)="onMove($event)" [attr.x-test-card-move]="card().id"> <option value="backlog">Backlog</option> <option value="inprogress">In Progress</option> <option value="review">Review</option> <option value="done">Done</option> </select> </label> <a class="btn btn-small btn-ghost edit-btn" [routerLink]="['/card', card().id, 'edit']" [attr.x-test-card-edit]="card().id">Edit</a>
  <button class="btn btn-small btn-danger delete-btn" type="button" (click)="store.removeCard(card().id)" [attr.x-test-card-delete]="card().id">Delete</button>
 </footer>
</article>
######### END FILE #########
