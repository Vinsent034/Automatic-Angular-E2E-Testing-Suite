#mutation-id: h
#element: delta
#name: board-column-count
#type: tag_mov_temp_mut
#status: COMPLETE
######### FILE C:\Users\vince\OneDrive\Desktop\App tirocinio\Kanban board\src\app\board\board.component.html #########
<section class="board-page" x-test-board>
  <div class="board-intro" x-test-board-intro>
    <h2 class="page-title" x-test-board-title>Project board</h2>
    <span class="badge badge-demo" data-kind="demo" x-test-demo-badge>Board demo</span>
    <p class="hint-banner" x-test-hint-banner>Use the Move menu on a card to change column</p>
  </div>

  <div class="toolbar" role="toolbar" aria-label="Board toolbar" x-test-toolbar>
    <div class="toolbar-group toolbar-search" role="search" x-test-toolbar-search>
      <label class="field-label" for="search-input" x-test-search-label>Search</label>
      <input id="search-input" class="input search-input" type="text" placeholder="Filter by title…" [value]="store.searchText()" (input)="onSearch($event)" x-test-search>
    </div>

    <div class="toolbar-group toolbar-priority" x-test-toolbar-priority>
      <label class="field-label" for="priority-filter" x-test-priority-label>Priority</label>
      <select id="priority-filter" class="input select priority-filter" [value]="store.priorityFilter()" (change)="onPriorityFilter($event)" x-test-filter-priority>
        <option value="all">All</option>
        <option value="low">Low</option>
        <option value="medium">Medium</option>
        <option value="high">High</option>
      </select>
    </div>

    <div class="toolbar-group toolbar-assignee" x-test-toolbar-assignee>
      <label class="field-label" for="assignee-filter" x-test-assignee-label>Assignee</label>
      <select id="assignee-filter" class="input select assignee-filter" [value]="store.assigneeFilter()" (change)="onAssigneeFilter($event)" x-test-filter-assignee>
        <option value="all">All</option>
        @for (person of store.assignees(); track person) {
          <option [value]="person">{{ person }}</option>
        }
      </select>
    </div>

    <div class="toolbar-group toolbar-info" x-test-toolbar-info>
      <span class="matching-label" x-test-matching-label>Matching</span>
      <span class="badge badge-filtered" data-kind="filtered" x-test-filtered-count>{{ store.filteredCount() }}</span>
    </div>

    <div class="toolbar-group toolbar-actions" x-test-toolbar-actions>
      <a class="btn btn-primary add-card-btn" routerLink="/card/new" role="button" x-test-add-card>Add card</a>
      <button class="btn btn-ghost reset-btn" type="button" (click)="store.reset()" x-test-reset>Reset board</button>
    </div>
  </div>

  <div class="board-grid" role="list" aria-label="Board columns" x-test-columns>
    <section class="column" data-column="backlog" role="listitem" aria-label="Backlog column" x-test-column="backlog">
      <header class="column-header">
        
        <span class="badge column-count" data-column="backlog" x-test-column-count="backlog">{{ store.backlogCount() }}</span>
      </header>
      <app-column colId="backlog">
    </app-column></section>

    <section class="column" data-column="inprogress" role="listitem" aria-label="In Progress column" x-test-column="inprogress">
      <header class="column-header">
        <h3 class="column-title" x-test-column-title="inprogress">In Progress</h3>
        <span class="badge column-count" data-column="inprogress" x-test-column-count="inprogress">{{ store.inProgressCount() }}</span>
      </header>
      <app-column colId="inprogress">
    </app-column></section>

    <section class="column" data-column="review" role="listitem" aria-label="Review column" x-test-column="review">
      <header class="column-header">
        <h3 class="column-title" x-test-column-title="review">Review</h3>
        <span class="badge column-count" data-column="review" x-test-column-count="review">{{ store.reviewCount() }}</span>
      </header>
      <app-column colId="review">
    </app-column></section>

    <section class="column" data-column="done" role="listitem" aria-label="Done column" x-test-column="done">
      <header class="column-header">
        <h3 class="column-title" x-test-column-title="done">Done</h3>
        <span class="badge column-count" data-column="done" x-test-column-count="done">{{ store.doneCount() }}</span>
      </header>
      <app-column colId="done">
    </app-column></section>
  </div>
</section>
######### END FILE #########
######### FILE C:\Users\vince\OneDrive\Desktop\App tirocinio\Kanban board\src\app\header\header.component.html #########
<header class="app-header" role="banner" x-test-header>
 <div class="header-inner">
  <div class="brand" x-test-brand>
   <span class="brand-icon" aria-hidden="true" x-test-brand-icon>▤</span>
   <h1 class="brand-name" x-test-app-title>FlowBoard</h1>
   <span class="brand-tagline" x-test-app-tagline>Kanban demo board</span>
  </div>
  <div class="header-stats" x-test-header-stats>
   <span class="total-label" x-test-total-label>Total cards</span> <span class="badge badge-total" data-kind="total" x-test-total-badge>{{ store.totalCards() }}</span>
  </div>
  <nav class="main-nav" role="navigation" aria-label="Main navigation" x-test-nav>
   <a class="nav-link" routerLink="/" routerLinkActive="active" [routerLinkActiveOptions]="{ exact: true }" x-test-nav-board>Board</a> <a class="nav-link" routerLink="/stats" routerLinkActive="active" x-test-nav-stats>Stats</a> <a class="btn btn-primary nav-new-card" routerLink="/card/new" role="button" x-test-new-card>New card</a>
  </nav>
 </div>
</header>
######### END FILE #########
