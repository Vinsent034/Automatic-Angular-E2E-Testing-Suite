#mutation-id: h
#element: alpha
#name: header-app-title
#type: tag_mov_temp_mut
#status: COMPLETE
######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\Kanban board\src\app\header\header.component.html #########
<header class="app-header" role="banner" x-test-header>
  <div class="header-inner">
    <div class="brand" x-test-brand>
      <span class="brand-icon" aria-hidden="true" x-test-brand-icon>▤</span>
      
      <span class="brand-tagline" x-test-app-tagline>Kanban demo board</span>
    </div>

    <div class="header-stats" x-test-header-stats>
      <span class="total-label" x-test-total-label>Total cards</span>
      <span class="badge badge-total" data-kind="total" x-test-total-badge>{{ store.totalCards() }}</span>
    </div>

    <nav class="main-nav" role="navigation" aria-label="Main navigation" x-test-nav>
      <a class="nav-link" routerLink="/" routerLinkActive="active" [routerLinkActiveOptions]="{ exact: true }" x-test-nav-board>Board</a>
      <a class="nav-link" routerLink="/stats" routerLinkActive="active" x-test-nav-stats>Stats</a>
      <a class="btn btn-primary nav-new-card" routerLink="/card/new" role="button" x-test-new-card>New card</a>
    </nav>
  </div>
</header>
######### END FILE #########
######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\Kanban board\src\app\stats\stats.component.html #########
<section class="stats-page" x-test-stats>
 <div class="page-heading" x-test-stats-heading>
  <h1 class="brand-name" x-test-app-title>FlowBoard</h1>
  <h2 class="page-title" x-test-stats-title>Board statistics</h2>
  <a class="btn btn-ghost back-btn" routerLink="/" x-test-stats-back>Back to board</a>
 </div>
 <div class="stats-grid" x-test-stats-cards>
  <div class="stat-card" data-stat="total" x-test-stat-total-card>
   <span class="stat-label" x-test-stat-total-label>Total cards</span> <span class="stat-value" x-test-stat-total>{{ store.totalCards() }}</span>
  </div>
  <div class="stat-card" data-stat="backlog" x-test-stat-backlog-card>
   <span class="stat-label" x-test-stat-backlog-label>Backlog</span> <span class="stat-value" x-test-stat-backlog>{{ store.backlogCount() }}</span>
  </div>
  <div class="stat-card" data-stat="inprogress" x-test-stat-inprogress-card>
   <span class="stat-label" x-test-stat-inprogress-label>In Progress</span> <span class="stat-value" x-test-stat-inprogress>{{ store.inProgressCount() }}</span>
  </div>
  <div class="stat-card" data-stat="review" x-test-stat-review-card>
   <span class="stat-label" x-test-stat-review-label>Review</span> <span class="stat-value" x-test-stat-review>{{ store.reviewCount() }}</span>
  </div>
  <div class="stat-card" data-stat="done" x-test-stat-done-card>
   <span class="stat-label" x-test-stat-done-label>Done</span> <span class="stat-value" x-test-stat-done>{{ store.doneCount() }}</span>
  </div>
  <div class="stat-card" data-stat="high" data-priority="high" x-test-stat-high-card>
   <span class="stat-label" x-test-stat-high-label>High priority</span> <span class="stat-value" x-test-stat-high>{{ store.highCount() }}</span>
  </div>
  <div class="stat-card" data-stat="medium" data-priority="medium" x-test-stat-medium-card>
   <span class="stat-label" x-test-stat-medium-label>Medium priority</span> <span class="stat-value" x-test-stat-medium>{{ store.mediumCount() }}</span>
  </div>
  <div class="stat-card" data-stat="low" data-priority="low" x-test-stat-low-card>
   <span class="stat-label" x-test-stat-low-label>Low priority</span> <span class="stat-value" x-test-stat-low>{{ store.lowCount() }}</span>
  </div>
 </div>
 <div class="stats-table-wrap" x-test-stats-table-section>
  <h3 class="section-title" x-test-stats-table-title>All cards</h3>
  <app-panel heading="Cards" note="one row per card">
   <table class="stats-table" x-test-stats-table>
    <thead>
     <tr>
      <th class="col-id" x-test-stats-th-id>Id</th>
      <th class="col-title" x-test-stats-th-title>Title</th>
      <th class="col-priority" x-test-stats-th-priority>Priority</th>
      <th class="col-assignee" x-test-stats-th-assignee>Assignee</th>
      <th class="col-column" x-test-stats-th-column>Column</th>
     </tr>
    </thead>
    <tbody>
     @for (card of store.cards(); track card.id) {
     <tr class="stats-row" [attr.data-card-id]="card.id" [attr.data-priority]="card.priority" [attr.x-test-stat-row]="card.id">
      <td class="cell-id">#{{ card.id }}</td>
      <td class="cell-title">{{ card.title }}</td>
      <td class="cell-priority">{{ card.priority }}</td>
      <td class="cell-assignee">{{ card.assignee }}</td>
      <td class="cell-column">{{ card.columnId }}</td>
     </tr>
     } @empty {
     <tr class="stats-row-empty">
      <td colspan="5" class="cell-empty" x-test-stats-empty>No cards on the board</td>
     </tr>
     }
    </tbody>
   </table>
  </app-panel>
 </div>
</section>
######### END FILE #########
