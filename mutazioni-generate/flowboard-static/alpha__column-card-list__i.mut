######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\Kanban board\src\app\column\column.component.html #########

  @for (card of store.cardsByColumn()(colId()); track card.id) {
    <li class="card-slot">
      <app-card [card]="card">
    </app-card></li>
  } @empty {
    <li class="empty-slot">
      <p class="empty-message" x-test-empty-message>No cards here</p>
    </li>
  }

######### END FILE #########
