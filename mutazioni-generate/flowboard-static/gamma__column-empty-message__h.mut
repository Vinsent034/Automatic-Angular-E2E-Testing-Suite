######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\Kanban board\src\app\panel\panel.component.html #########
<section class="panel">
 <header class="panel-head">
  <ul class="card-list" [attr.data-column]="colId()" x-test-card-list>
   @for (card of store.cardsByColumn()(colId()); track card.id) {
   <li class="card-slot"><app-card [card]="card"> </app-card></li>
   } @empty {
   <li class="empty-slot">
    <p class="empty-message" x-test-empty-message>No cards here</p>
   </li>
   }
  </ul>
  <h4 class="panel-heading">{{ heading() }}</h4>
  <span class="panel-note">{{ note() }}</span>
 </header>
 <div class="panel-body">
  <ng-content></ng-content>
 </div>
</section>
######### END FILE #########
