######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\Kanban board\src\app\card-form\card-form.component.html #########
<section class="form-page" x-test-card-form>
  <div class="page-heading" x-test-form-heading>
    @if (editing()) {
      <h2 class="page-title" x-test-form-title-edit>Edit card</h2>
    } @else {
      <h2 class="page-title" x-test-form-title-new>New card</h2>
    }
    <a class="btn btn-ghost back-btn" routerLink="/" x-test-form-back>Back to board</a>
  </div>

  
</section>
######### END FILE #########
######### FILE C:\Users\vince\OneDrive\Desktop\Università\App tirocinio\Kanban board\src\app\column\column.component.html #########
<ul class="card-list" [attr.data-column]="colId()" x-test-card-list>
 @for (card of store.cardsByColumn()(colId()); track card.id) {
 <li class="card-slot"><app-card [card]="card"> </app-card></li>
 } @empty {
 <li class="empty-slot">
  <p class="empty-message" x-test-empty-message>No cards here</p>
 </li>
 }
</ul>
######### END FILE #########
