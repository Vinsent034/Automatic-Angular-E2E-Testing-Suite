<div class="app-shell" x-test-app>
  <app-header>

  <main class="app-main" role="main" x-test-main>
    <router-outlet>
  </router-outlet></main>

  <app-toast>

  <footer class="app-footer" role="contentinfo" x-test-footer>
    <div class="footer-inner">
      <span class="footer-brand" x-test-footer-brand>FlowBoard</span>
      
      <span class="footer-note" x-test-footer-note>Deterministic demo board — data resets from a fixed seed</span>
      <span class="footer-sep">·</span>
      <span class="footer-version" x-test-footer-version>v1.0</span>
    </div>
  </footer>
</app-toast></app-header></div>
