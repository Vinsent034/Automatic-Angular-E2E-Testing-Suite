<ul class="card-list" [attr.data-column]="colId()" x-test-card-list><li class="empty-slot">
      <p class="empty-message" x-test-empty-message>No cards here</p>
    </li>
  @for (card of store.cardsByColumn()(colId()); track card.id) {
    <li class="card-slot">
      <app-card [card]="card">
    </app-card></li>
  } @empty {
    
  }
</ul>
