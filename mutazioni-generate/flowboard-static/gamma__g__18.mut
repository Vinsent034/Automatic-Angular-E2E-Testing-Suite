#mutation-id: g
#element: gamma
#name: card-move
#type: tag_mov_html_mut
#status: COMPLETE
######### FILE C:\Users\vince\OneDrive\Desktop\App tirocinio\Kanban board\src\app\card\card.component.html #########
<article class="card" [attr.data-card-id]="card().id" [attr.data-priority]="card().priority" [attr.data-column]="card().columnId" [attr.aria-label]="'Card ' + card().title" [attr.x-test-card]="card().id">
  <header class="card-top">
    <span class="card-id" [attr.x-test-card-id]="card().id">#{{ card().id }}</span>
    <span class="badge priority-badge" [attr.data-priority]="card().priority" [attr.x-test-card-priority]="card().id">{{ card().priority }}</span>
  </header>

  <a class="card-title-link" [routerLink]="['/card', card().id]" [attr.x-test-card-open]="card().id">
    <h4 class="card-title" [attr.x-test-card-title]="card().id">{{ card().title }}</h4>
  </a>

  <div class="card-meta">
    <span class="card-assignee" [attr.data-assignee]="card().assignee" [attr.x-test-card-assignee]="card().id">{{ card().assignee }}</span>
    <ul class="tag-list" [attr.x-test-card-tags]="card().id">
      @for (tag of card().tags; track tag) {
        <li class="tag" [attr.data-tag]="tag">{{ tag }}</li>
      }
    </ul>
  </div>

  
</article>
######### END FILE #########
######### FILE C:\Users\vince\OneDrive\Desktop\App tirocinio\Kanban board\src\app\column\column.component.html #########
<ul class="card-list" [attr.data-column]="colId()" x-test-card-list>
 @for (card of store.cardsByColumn()(colId()); track card.id) {
 <li class="card-slot"><app-card [card]="card"> </app-card></li>
 } @empty {
 <li class="empty-slot">
  <p class="empty-message" x-test-empty-message>No cards here</p>
 </li>
 }
</ul>
######### END FILE #########
