#mutation-id: a
#element: alpha
#name: column-card-list
#type: attr_val_mod_mut
#status: COMPLETE
######### FILE C:\Users\vince\OneDrive\Desktop\App tirocinio\Kanban board\src\app\column\column.component.html #########
<ul class="card-list" [attr.data-column]="colId()_mutated" x-test-card-list>
  @for (card of store.cardsByColumn()(colId()); track card.id) {
    <li class="card-slot">
      <app-card [card]="card">
    </app-card></li>
  } @empty {
    <li class="empty-slot">
      <p class="empty-message" x-test-empty-message>No cards here</p>
    </li>
  }
</ul>
######### END FILE #########
