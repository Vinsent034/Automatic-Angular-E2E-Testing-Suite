######### FILE C:\Users\vince\OneDrive\Desktop\App tirocinio\Kanban board\src\app\toast\toast.component.html #########
<aside class="toast-bar" role="status" aria-live="polite" x-test-toast-bar>
  <span class="toast-icon" aria-hidden="true" x-test-toast-icon>ℹ</span>
  <span class="toast-label" x-test-toast-label>Last action:</span>
  
</aside>
######### END FILE #########
######### FILE C:\Users\vince\OneDrive\Desktop\App tirocinio\Kanban board\src\app\column\column.component.html #########
<ul class="card-list" [attr.data-column]="colId()" x-test-card-list>
 @for (card of store.cardsByColumn()(colId()); track card.id) {
 <li class="card-slot"><app-card [card]="card"> </app-card></li>
 } @empty {
 <li class="empty-slot">
  <p class="empty-message" x-test-empty-message>No cards here</p>
 </li>
 }
</ul>
######### END FILE #########
